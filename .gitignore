# ── Secrets & credentials ─────────────────────────────────────
.env
secrets/.netrc

# ── Private keys ──────────────────────────────────────────────
certs/*.key

# ── Vault cert-watcher state (host-local, không phải secret) ───
.vault-cert-versions/

# ── Patched APISIX internals (generated by 1-patch-template-lua.sh) ──
init.lua
init.lua.orig
ngx_tpl.lua
ngx_tpl.lua.orig
vault.lua.lua
vault.lua.orig
config_yaml.lua
config_yaml.lua.orig
kafka-logger.lua
kafka-logger.lua.orig

# ── gitsync runtime (managed by git-sync, not committed) ──────
gitsync/

# ── Dashboard working clone (clone lồng trong clone — KHÔNG commit) ──
dashboard-workspace/

# ── Dashboard hub (máy local) — peers.yaml có thể chứa auth_basic, KHÔNG commit ──
dashboard/hub/peers.yaml

# ── Dashboard dev/build artifacts — tự sinh khi dev/test local, KHÔNG commit ──
# (bảng "lệnh nào sinh ra file gì" xem dashboard/README.md mục "File tự sinh")
dashboard/frontend/node_modules/
dashboard/frontend/dist/
dashboard/backend/.venv/
__pycache__/
.pytest_cache/


# ── Logs ──────────────────────────────────────────────────────
logs/

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride